end

local function removerEspJogador(player)
    if cache[player] then
        if cache[player].box then pcall(function() cache[player].box:Remove() end) end
        if cache[player].line then pcall(function() cache[player].line:Remove() end) end
        if cache[player].lifeBg then pcall(function() cache[player].lifeBg:Remove() end) end
        if cache[player].lifeFill then pcall(function() cache[player].lifeFill:Remove() end) end
        if cache[player].nameText then pcall(function() cache[player].nameText:Remove() end) end
        if cache[player].distanceText then pcall(function() cache[player].distanceText:Remove() end) end
        cache[player] = nil
    end
end

