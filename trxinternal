UserInputService.InputBegan:Connect(function(input, gpe)
    if not scriptAtivo then return end
    if gpe then return end
    local nomeTecla = input.KeyCode.Name ~= "Unknown" and input.KeyCode.Name or input.UserInputType.Name
    
    if nomeTecla == keybindNoclip and keybindNoclip ~= "NONE" then
        toggleNoclip()
    end
    
    if nomeTecla == keybindAimbot then
        aimbotPressionado = true
    end
    
    if nomeTecla == keybindMenuGlobal then
        menuAberto = not menuAberto
        fundo.Visible = (menuAberto and not streamModeAtivo)
    end
    
    if nomeTecla == keybindStreamMode and forcarStreamMode then
        forcarStreamMode(not streamModeAtivo)
    end
end)

UserInputService.InputEnded:Connect(function(input)
    if not scriptAtivo then return end
    local nomeTecla = input.KeyCode.Name ~= "Unknown" and input.KeyCode.Name or input.UserInputType.Name
    if nomeTecla == keybindAimbot then
        aimbotPressionado = false
    end
end)

