RunService.RenderStepped:Connect(function()
    if not scriptAtivo then return end

    if aimbotActive and aimbotPressionado then
        local alvo = obterJogadorMaisProximo()
        if alvo and alvo.Character then
            local head = alvo.Character:FindFirstChild("Head") or alvo.Character:FindFirstChild("HumanoidRootPart")
            if head then
                local targetCFrame = CFrame.lookAt(Camera.CFrame.Position, head.Position)
                if aimbotLegit then
                    Camera.CFrame = Camera.CFrame:Lerp(targetCFrame, 0.12)
                else
                    Camera.CFrame = targetCFrame
                end
            end
        end
    end

    if spinBotActive and LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
        LocalPlayer.Character.HumanoidRootPart.CFrame = LocalPlayer.Character.HumanoidRootPart.CFrame * CFrame.Angles(0, math.rad(spinVelocity), 0)
    end

    for _, player in ipairs(Players:GetPlayers()) do
        if player == LocalPlayer then continue end
        
        if not cache[player] then
            cache[player] = {
                box = criarDesenho("Square", {Thickness = 1, Filled = false, Visible = false}),
                line = criarDesenho("Line", {Thickness = 1, Visible = false}),
                nameText = criarDesenho("Text", {Size = 13, Center = true, Visible = false}),
                distanceText = criarDesenho("Text", {Size = 12, Center = true, Visible = false}),
                lifeBg = criarDesenho("Square", {Thickness = 1, Filled = true, Color = Color3.fromRGB(0,0,0), Visible = false}),
                lifeFill = criarDesenho("Square", {Thickness = 1, Filled = true, Visible = false})
            }
        end
        
        local c = cache[player]
        local char = player.Character
        local root = char and char:FindFirstChild("HumanoidRootPart")
        local hum = char and char:FindFirstChild("Humanoid")
        
        if root and hum and hum.Health > 0 and not isTeammate(player) and not streamModeAtivo then
            local pos, onScreen = Camera:WorldToViewportPoint(root.Position)
            
            if onScreen then
                local sX = 2200 / pos.Z
                local sY = 3200 / pos.Z
                local tX, tY = pos.X - sX/2, pos.Y - sY/2
                
                if boxActive then
                    c.box.Size = Vector2.new(sX, sY)
                    c.box.Position = Vector2.new(tX, tY)
                    c.box.Color = boxColor
                    c.box.Visible = true
                else c.box.Visible = false end
                
                if linesActive then
                    local origemLinha = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y)
                    if linesOriginMode == "Topo" then 
                        origemLinha = Vector2.new(Camera.ViewportSize.X / 2, 0)
                    elseif linesOriginMode == "Meio" then 
                        origemLinha = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
                    elseif linesOriginMode == "Baixo" then
                        origemLinha = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y)
                    end
                    
                    c.line.From = origemLinha
                    c.line.To = Vector2.new(pos.X, pos.Y)
                    c.line.Color = linesColor
                    c.line.Visible = true
                else c.line.Visible = false end
                
                if nameActive then
                    c.nameText.Position = Vector2.new(pos.X, tY - 16)
                    c.nameText.Text = player.Name
                    c.nameText.Color = nameColor
                    c.nameText.Visible = true
                else c.nameText.Visible = false end
                
                if distanceActive then
                    local d = (Camera.CFrame.Position - root.Position).Magnitude
                    c.distanceText.Position = Vector2.new(pos.X, tY + sY + 2)
                    c.distanceText.Text = string.format("[%d studs]", d)
                    c.distanceText.Color = distanceColor
                    c.distanceText.Visible = true
                else c.distanceText.Visible = false end
                
                if lifeActive then
                    local pct = math.clamp(hum.Health / hum.MaxHealth, 0, 1)
                    c.lifeBg.Size = Vector2.new(3, sY)
                    c.lifeBg.Position = Vector2.new(tX - 6, tY)
                    c.lifeBg.Visible = true
                    
                    c.lifeFill.Size = Vector2.new(3, sY * pct)
                    c.lifeFill.Position = Vector2.new(tX - 6, tY + (sY * (1 - pct)))
                    c.lifeFill.Color = lifeColor
                    c.lifeFill.Visible = true
                else 
                    c.lifeBg.Visible = false 
                    c.lifeFill.Visible = false 
                end
            else
                for _, obj in pairs(c) do obj.Visible = false end
            end
        else
            for _, obj in pairs(c) do obj.Visible = false end
        end
    end
end)

