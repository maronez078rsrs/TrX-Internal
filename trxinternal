local function aplicarNoclip()
    local char = LocalPlayer.Character
    if not char then return end
    
    local humanoid = char:FindFirstChild("Humanoid")
    local rootPart = char:FindFirstChild("HumanoidRootPart")
    
    if noclipActive then
        for _, part in ipairs(char:GetDescendants()) do
            if part:IsA("BasePart") then
                part.CanCollide = false
            end
        end
        
        if humanoid then
            humanoid.PlatformStand = true
            humanoid.WalkSpeed = 50
            humanoid.JumpPower = 0
            humanoid.AutoRotate = true
            humanoid.Sit = false
        end
        
        if rootPart then
            rootPart.Velocity = Vector3.new(0, 0, 0)
        end
    else
        for _, part in ipairs(char:GetDescendants()) do
            if part:IsA("BasePart") then
                part.CanCollide = true
            end
        end
        
        if humanoid then
            humanoid.PlatformStand = false
            humanoid.WalkSpeed = 16
            humanoid.JumpPower = 50
        end
    end
end

local function iniciarControleVoo()
    if not noclipActive then return end
    
    local char = LocalPlayer.Character
    if not char then return end
    
    local rootPart = char:FindFirstChild("HumanoidRootPart")
    local humanoid = char:FindFirstChild("Humanoid")
    if not rootPart or not humanoid then return end
    
    local function moverVoo(delta)
        if not noclipActive then return end
        
        local moveDirection = Vector3.new()
        local cameraLook = Camera.CFrame
        
        if UserInputService:IsKeyDown(Enum.KeyCode.W) then
            moveDirection = moveDirection + cameraLook.LookVector
        end
        if UserInputService:IsKeyDown(Enum.KeyCode.S) then
            moveDirection = moveDirection - cameraLook.LookVector
        end
        if UserInputService:IsKeyDown(Enum.KeyCode.A) or UserInputService:IsKeyDown(Enum.KeyCode.Left) then
            moveDirection = moveDirection - cameraLook.RightVector
        end
        if UserInputService:IsKeyDown(Enum.KeyCode.D) or UserInputService:IsKeyDown(Enum.KeyCode.Right) then
            moveDirection = moveDirection + cameraLook.RightVector
        end
        if UserInputService:IsKeyDown(Enum.KeyCode.Space) then
            moveDirection = moveDirection + Vector3.new(0, 1, 0)
        end
        if UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) then
            moveDirection = moveDirection - Vector3.new(0, 1, 0)
        end
        
        if moveDirection.Magnitude > 0 then
            moveDirection = moveDirection.Unit * flySpeed * delta
            rootPart.CFrame = rootPart.CFrame + moveDirection
        end
    end
    
    local conexaoVoo
    conexaoVoo = RunService.RenderStepped:Connect(function(delta)
        if noclipActive then
            moverVoo(delta)
        else
            if conexaoVoo then
                conexaoVoo:Disconnect()
            end
        end
    end)
    
    return conexaoVoo
end

local function toggleNoclip()
    noclipActive = not noclipActive
    
    if noclipActive then
        aplicarNoclip()
        if not flyConnection then
            flyConnection = iniciarControleVoo()
        end
    else
        if flyConnection then
            flyConnection:Disconnect()
            flyConnection = nil
        end
        aplicarNoclip()
    end
    
    for _, switch in ipairs(switchesAtivos) do
        if switch.Nome == "Noclip" then
            switch.Instance.Text = noclipActive and "✓" or ""
            switch.Instance.BackgroundColor3 = noclipActive and corTemaGlobal or Color3.fromRGB(25, 25, 25)
            switch.EstadoAtual = noclipActive
        end
    end
end

local function aplicarSpeed()
    local char = LocalPlayer.Character
    if not char then return end
    local humanoid = char:FindFirstChild("Humanoid")
    if not humanoid then return end
    
    if speedActive then
        humanoid.WalkSpeed = speedValue
    else
        humanoid.WalkSpeed = 16
    end
end

local function aplicarJump()
    local char = LocalPlayer.Character
    if not char then return end
    local humanoid = char:FindFirstChild("Humanoid")
    if not humanoid then return end
    
    if jumpActive then
        humanoid.JumpPower = jumpValue * 10 
        humanoid.UseJumpPower = true
    else
        humanoid.JumpPower = 50
        humanoid.UseJumpPower = false
    end
end

local function teleportarPara(player)
    if not player or not player.Character then return end
    local targetRoot = player.Character:FindFirstChild("HumanoidRootPart")
    local localRoot = LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    if targetRoot and localRoot then
        localRoot.CFrame = targetRoot.CFrame + Vector3.new(0, 3, 0)
    end
end

