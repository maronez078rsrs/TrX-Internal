    label.TextSize = 12
    label.Font = Enum.Font.Gotham
    label.TextXAlignment = Enum.TextXAlignment.Left
    label.Parent = card
    
    local dropdownBtn = Instance.new("TextButton")
    dropdownBtn.Size = UDim2.new(0, 120, 0, 26)
    dropdownBtn.Position = UDim2.new(1, -130, 0.5, -13)
    dropdownBtn.BackgroundColor3 = Color3.fromRGB(10, 10, 10)
    dropdownBtn.Text = "Selecionar..."
    dropdownBtn.TextColor3 = Color3.fromRGB(180, 180, 180)
    dropdownBtn.TextSize = 11
    dropdownBtn.Font = Enum.Font.GothamBold
    dropdownBtn.Parent = card
    
    local btnCorner = Instance.new("UICorner")
    btnCorner.CornerRadius = UDim.new(0, 4)
    btnCorner.Parent = dropdownBtn
    
    local listaFrame = Instance.new("Frame")
    listaFrame.Size = UDim2.new(0, 120, 0, 0)
    listaFrame.Position = UDim2.new(1, -130, 0, 32)
    listaFrame.BackgroundColor3 = Color3.fromRGB(14, 14, 14)
    listaFrame.BorderSizePixel = 1
    listaFrame.BorderColor3 = Color3.fromRGB(40, 40, 40)
    listaFrame.Visible = false
    listaFrame.ClipsDescendants = true
    listaFrame.Parent = card
    
    local listaCorner = Instance.new("UICorner")
    listaCorner.CornerRadius = UDim.new(0, 4)
    listaCorner.Parent = listaFrame
    
    local listaLayout = Instance.new("UIListLayout")
    listaLayout.Padding = UDim.new(0, 2)
    listaLayout.SortOrder = Enum.SortOrder.LayoutOrder
    listaLayout.Parent = listaFrame
    
    local function atualizarLista()
        for _, child in ipairs(listaFrame:GetChildren()) do
            if child:IsA("TextButton") then
                child:Destroy()
            end
        end
        
        local altura = 0
        for _, player in ipairs(Players:GetPlayers()) do
            if player ~= LocalPlayer then
                local btn = Instance.new("TextButton")
                btn.Size = UDim2.new(1, 0, 0, 22)
                btn.BackgroundTransparency = 1
                btn.Text = player.Name
                btn.TextColor3 = Color3.fromRGB(200, 200, 200)
                btn.TextSize = 11
                btn.Font = Enum.Font.Gotham
                btn.TextXAlignment = Enum.TextXAlignment.Left
                btn.Parent = listaFrame
                
                local padding = Instance.new("UIPadding")
                padding.PaddingLeft = UDim.new(0, 8)
                padding.Parent = btn
                
                btn.MouseButton1Click:Connect(function()
                    teleportarPara(player)
                    dropdownBtn.Text = player.Name
                    listaFrame.Visible = false
                end)
                
                altura = altura + 22
            end
        end
        
        listaFrame.Size = UDim2.new(0, 120, 0, math.min(altura, 150))
    end
    
    dropdownBtn.MouseButton1Click:Connect(function()
        listaFrame.Visible = not listaFrame.Visible
        if listaFrame.Visible then
            atualizarLista()
        end
    end)
    
    UserInputService.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            local mousePos = UserInputService:GetMouseLocation()
            local absX = listaFrame.AbsolutePosition.X
            local absY = listaFrame.AbsolutePosition.Y
            if mousePos.X < absX or mousePos.X > absX + listaFrame.AbsoluteSize.X or
               mousePos.Y < absY or mousePos.Y > absY + listaFrame.AbsoluteSize.Y then
                listaFrame.Visible = false
            end
        end
    end)
    
    Players.PlayerAdded:Connect(function()
        if listaFrame.Visible then atualizarLista() end
    end)
    Players.PlayerRemoving:Connect(function()
        if listaFrame.Visible then atualizarLista() end
    end)
end

