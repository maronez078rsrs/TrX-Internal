    local valorAtual = valorInicial
    
    local function atualizarSlider()
        local mousePos = UserInputService:GetMouseLocation()
        local posX = math.clamp(mousePos.X - sliderBg.AbsolutePosition.X, 0, sliderBg.AbsoluteSize.X)
        local pct = posX / sliderBg.AbsoluteSize.X
        valorAtual = math.floor(min + (max - min) * pct)
        fill.Size = UDim2.new(pct, 0, 1, 0)
        valorLabel.Text = tostring(valorAtual)
        callback(valorAtual)
    end
    
    sliderBtn.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            segurando = true
            atualizarSlider()
        end
    end)
    
    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            segurando = false
        end
    end)
    
    UserInputService.InputChanged:Connect(function(input)
        if segurando and input.UserInputType == Enum.UserInputType.MouseMovement then
            atualizarSlider()
        end
    end)
end

