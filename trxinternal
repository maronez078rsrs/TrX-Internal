local function aplicarRecoil()
    pcall(function()
        local char = LocalPlayer.Character
        if not char then return end
        
        local tool = char:FindFirstChildOfClass("Tool")
        if not tool then return end
        
        local config = tool:FindFirstChild("Configuration")
        if config then
            for _, child in ipairs(config:GetChildren()) do
                local nome = string.lower(child.Name)
                if string.find(nome, "recoil") or string.find(nome, "spread") or string.find(nome, "accuracy") or string.find(nome, "shake") then
                    if child:IsA("NumberValue") or child:IsA("IntValue") then
                        child.Value = 0
                    end
                end
            end
        end
        
        for _, child in ipairs(tool:GetDescendants()) do
            if child:IsA("NumberValue") or child:IsA("IntValue") then
                local nome = string.lower(child.Name)
                if string.find(nome, "recoil") or string.find(nome, "spread") or string.find(nome, "accuracy") or string.find(nome, "shake") then
                    child.Value = 0
                end
            end
        end
    end)
end

